generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Video {
  id String @id @default(uuid())
  title String
  sourceType String @default("SIMULATION")
  bvid String?
  originalUrl String?
  localOriginalName String?
  sourceHash String?
  durationMs Int?
  creatorName String?
  publishedAt DateTime?
  coverUrl String?
  overallStatus String @default("WAITING")
  currentStage String?
  latestErrorCode String?
  latestErrorMessage String?
  optionsJson String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs Job[]
  runs StageRun[]
  results StageResult[]
  artifacts Artifact[]
  transcripts Transcript[]
  summaries Summary[]
  checkpoints Checkpoint[]
  @@unique([sourceType, bvid])
  @@index([overallStatus, createdAt])
  @@index([createdAt, id])
}
model Job {
  id String @id @default(uuid())
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stage String
  status String @default("QUEUED")
  attempt Int @default(0)
  maxAttempts Int @default(3)
  availableAt DateTime @default(now())
  leaseOwner String?
  leaseExpiresAt DateTime?
  inputFingerprint String
  cancelRequestedAt DateTime?
  lastErrorCode String?
  lastErrorMessage String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  runs StageRun[]
  @@index([status, availableAt])
  @@index([videoId, status])
}
model StageRun {
  id String @id @default(uuid())
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage String
  attempt Int
  status String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  errorCode String?
  errorMessage String?
  outputJson String?
  @@unique([jobId, attempt])
  @@index([videoId, startedAt])
}
model StageResult {
  id String @id @default(uuid())
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stage String
  inputFingerprint String
  outputJson String
  createdAt DateTime @default(now())
  @@unique([videoId, stage, inputFingerprint])
}
model Event {
  id Int @id @default(autoincrement())
  videoId String
  payload String
  createdAt DateTime @default(now())
}
model WorkerLease {
  id String @id
  owner String?
  expiresAt DateTime
}
model Command {
  key String @id
  fingerprint String
  responseJson String
  expiresAt DateTime
}

model Artifact {
  id String @id @default(uuid())
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  kind String
  storageKey String @unique
  sizeBytes BigInt
  sha256 String
  mimeType String
  createdAt DateTime @default(now())
  deletedAt DateTime?
  isCurrent Boolean @default(true)
  @@index([videoId, kind, createdAt])
}
model Transcript {
  id String @id @default(uuid())
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  revision Int
  fullText String
  language String
  provider String
  model String
  durationMs Int
  timestampPrecision String
  isCurrent Boolean @default(true)
  createdAt DateTime @default(now())
  segments TranscriptSegment[]
  summaries Summary[]
  @@unique([videoId, revision])
}
model TranscriptSegment {
  id String @id @default(uuid())
  transcriptId String
  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  sequence Int
  startMs Int
  endMs Int
  text String
  @@unique([transcriptId, sequence])
}
model PromptVersion {
  id String @id @default(uuid())
  revision Int @unique
  name String @default("视频总结")
  body String
  hash String @unique
  createdAt DateTime @default(now())
  summaries Summary[]
}
model Summary {
  id String @id @default(uuid())
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  transcriptId String
  transcript Transcript @relation(fields: [transcriptId], references: [id])
  promptVersionId String
  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id])
  revision Int
  provider String
  model String
  structuredJson String
  renderedText String
  durationMs Int
  chunkCount Int
  isCurrent Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([videoId, revision])
}
model Checkpoint {
  id String @id
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  kind String
  outputJson String
  createdAt DateTime @default(now())
  @@index([videoId, kind])
}

model SystemSettings {
  id String @id @default("singleton")
  revision Int @default(0)
  valuesJson String @default("{}")
  activePromptId String?
  testsJson String @default("{}")
}
