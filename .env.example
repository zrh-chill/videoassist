# 复制所需变量到已有 .env，不覆盖其中的模型密钥。
APP_HOST=127.0.0.1
APP_PORT=3001
DATA_DIR=./data

# 阶段一必须显式启用；不会调用真实 S2T/LLM。
ENABLE_SIMULATION=true
MOCK_STAGE_MS=1500

# 保持与现有 .env 兼容，阶段二接入真实调用。
S2T_API_URL=
S2T_API_KEY=
S2T_MODEL=
write_API_URL=
write_API_KEY=
write_MODEL=

# 可替代上述旧变量名的标准配置（阶段二解析密钥引用）。
# S2T_BASE_URL=
# S2T_API_KEY_REF=env:S2T_API_KEY
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY_REF=env:write_API_KEY
