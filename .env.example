# 仅复制需要的配置到已有 .env，不覆盖模型密钥。
APP_HOST=127.0.0.1
APP_PORT=3001
DATA_DIR=./data
ENABLE_SIMULATION=false
MOCK_STAGE_MS=1500

# 兼容已有配置；S2T 可填写完整端点，LLM 可填写 /v1 基础地址。
S2T_API_URL=https://api.siliconflow.cn/v1/audio/transcriptions
S2T_API_KEY=
S2T_MODEL=FunAudioLLM/SenseVoiceSmall
write_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
write_API_KEY=
write_MODEL=qwen3.7-flash

# 也可使用标准变量名和密钥引用。
# S2T_BASE_URL=
# S2T_API_KEY_REF=env:S2T_API_KEY
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY_REF=file:C:/private/model-key.txt

# 默认从 PATH 查找；Windows 路径包含空格也可直接填写。
# FFMPEG_PATH=D:/Program Files/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=D:/Program Files/ffmpeg/bin/ffprobe.exe
# YTDLP_PATH=D:/Program Files/Python312/Scripts/yt-dlp.exe
# BILIBILI_COOKIE_FILE_REF=file:C:/private/bilibili-cookies.txt

UPLOAD_MAX_BYTES=4294967296
DOWNLOAD_MAX_BYTES=4294967296
AUDIO_CHUNK_MINUTES=15
S2T_MAX_BYTES=45000000
MODEL_TIMEOUT_MS=600000
SUMMARY_MAX_INPUT_TOKENS=24000
LLM_MAX_OUTPUT_TOKENS=8000
SUMMARY_PROMPT_FILE=docs/ai_summary_system_prompt.md
