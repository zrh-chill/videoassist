{
  "name": "videoassist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "pnpm db:generate && pnpm db:migrate && concurrently -k -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:web": "pnpm --filter @videoassist/web dev",
    "build": "pnpm db:generate && tsc --noEmit && pnpm --filter @videoassist/web build",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "@fastify/multipart": "^9.0.0",
    "js-tiktoken": "^1.0.21",
    "@prisma/client": "6.19.3",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.0",
    "dotenv": "^17.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
